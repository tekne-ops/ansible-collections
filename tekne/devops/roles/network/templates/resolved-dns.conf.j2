# Managed by tekne.devops.network — Domains/cache only.
# Resolver list and DNSOverTLS live in 99-dot-override.conf (higher priority).
[Resolve]
{% if network_dns_search_domains | length > 0 %}
Domains={{ network_dns_search_domains | join(' ') }}
{% endif %}
DNSSEC={{ network_dnssec }}
Cache={{ network_dns_cache }}
