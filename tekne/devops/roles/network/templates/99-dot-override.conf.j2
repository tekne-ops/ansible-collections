# Managed by tekne.devops.network — lexical 99- wins over 95-dns.conf
#
# Cablecolor drops 60-70% of port 53 traffic to every destination (router,
# Google, Quad9 alike), while ICMP/443/853 are clean. Force encrypted DNS
# on port 853 so lookups never touch port 53.
#
# Server choice is constrained by both ISPs:
#   Quad9   853 -> works on Cablecolor AND Tigo  (verified)
#   Google  853 -> works on Tigo                 (verified)
#   1.1.1.1 853 -> BLOCKED by Tigo, do not use as primary
[Resolve]
DNS={{ network_dns_servers | join(' ') }}
DNSOverTLS=yes
